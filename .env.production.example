# Names only. Set the values in the host environment. Do not put secrets in this file.
# Wearables aggregator used by connect: terra | junction | thryve (default terra)
WEARABLES_AGGREGATOR=
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_SIGNING_SECRET=
# Junction (formerly Vital). JUNCTION_ENVIRONMENT sandbox|production, JUNCTION_REGION us|eu
JUNCTION_API_KEY=
JUNCTION_WEBHOOK_SECRET=
JUNCTION_ENVIRONMENT=
JUNCTION_REGION=
# Thryve. THRYVE_WEBHOOK_AUTH is the Authorization header value set in the Thryve Dashboard
THRYVE_USERNAME=
THRYVE_PASSWORD=
THRYVE_AUTH_ID=
THRYVE_AUTH_SECRET=
THRYVE_WEBHOOK_AUTH=
