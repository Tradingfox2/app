{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 does not load transitive @types. Playwright uses Buffer.
    "types": ["node"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/components/anatomy/ref",
    "src/linking.test.ts",
    "src/profile-patch.test.ts",
    "src/training-week.test.ts",
    "src/activity-day.test.ts",
    "src/recorder-math.test.ts",
    "src/weekly-review.test.ts",
    "src/sentry-gate.test.ts",
    "src/metric-state.test.ts"
  ]
}
