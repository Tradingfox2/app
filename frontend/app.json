{
  "expo": {
    "name": "IronFlow",
    "slug": "ironflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["frontend", "ironflow"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironflow.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan gym QR codes to log your visits",
        "NSPhotoLibraryUsageDescription": "Upload photos of your blood panels",
        "NSLocationWhenInUseUsageDescription": "Record the route, distance, and pace of a walk, run, or ride while this screen is open.",
        "NSMotionUsageDescription": "Count steps during a walk, run, or hike while the recording is running."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#101418"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ironflow.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#101418"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Record the route, distance, and pace of a walk, run, or ride while this screen is open."
        }
      ],
      "expo-localization",
      "expo-video",
      "expo-notifications",
      "./plugins/withHealth"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
