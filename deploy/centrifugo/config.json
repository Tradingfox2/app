{
  "client": {
    "token": {
      "hmac_secret_key": "set-CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY-instead"
    },
    "allowed_origins": [
      "https://app.example.com"
    ]
  },
  "http_api": {
    "key": "set-CENTRIFUGO_HTTP_API_KEY-instead"
  },
  "channel": {
