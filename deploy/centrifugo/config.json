      {
        "name": "channel",
        "history_size": 100,
        "history_ttl": "600s",
        "force_recovery": true
      },
      {
        "name": "user",
        "history_size": 100,
        "history_ttl": "600s",
        "force_recovery": true
      },
      {
        "name": "community",
        "history_size": 20,
        "history_ttl": "300s"
      }
    ]
  }
}
